# FinTrack Pro v2 — Environment Variables Template
#
# Copy this file to .env.local and fill in values.
# NEVER commit actual credentials to version control.
#
# IMPORTANT:
# - Server-only secrets MUST NOT use the NEXT_PUBLIC_ prefix.
# - NEXT_PUBLIC_ variables are embedded in the client bundle and visible to all users.
# - Use NEXT_PUBLIC_ ONLY for values that are intentionally public (e.g., API base URL).
#
# Current phase: client-side only (localStorage persistence).
# These variables are placeholders for the future PostgreSQL/Supabase backend.

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="FinTrack Pro"
NEXT_PUBLIC_APP_VERSION="2.0.0"
# NEXT_PUBLIC_API_BASE_URL=https://api.yourapp.com

# ── Future: Database (PostgreSQL) ────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/fintrack
# DB_POOL_SIZE=10

# ── Future: Supabase (if used) ───────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key          # Safe for NEXT_PUBLIC_ if needed
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # NEVER NEXT_PUBLIC_
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Future: JWT / Session ────────────────────────────────────
# JWT_SECRET=replace-with-strong-random-secret-minimum-32-chars
# SESSION_SECRET=replace-with-strong-random-secret

# ── Future: Object Storage (receipt images) ──────────────────
# OBJECT_STORAGE_ENDPOINT=https://storage.example.com
# OBJECT_STORAGE_BUCKET=fintrack-receipts-private
# OBJECT_STORAGE_ACCESS_KEY=your-access-key
# OBJECT_STORAGE_SECRET_KEY=your-secret-key

# ── Future: Email (for notifications) ────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourapp.com
# SMTP_PASSWORD=your-smtp-password

# ── Future: Rate Limiting / Redis ────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Feature Flags ────────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_RECEIPTS=false

# Backend foundation: disabled until DB and trusted identity adapter are configured.
ENABLE_BACKEND_API=false
ENABLE_DEMO_API=false
# Canonical browser origin, no trailing slash. HTTPS is required in production.
APP_ORIGIN=https://localhost:3000
# Runtime role must be fintrack_runtime; NEVER use migration/admin credentials.
# DATABASE_URL=postgresql://fintrack_runtime:REPLACE@localhost:5432/fintrack
# Optional PEM CA for a managed database. TLS verification is never disabled in production.
# DATABASE_CA=
