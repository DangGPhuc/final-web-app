# Personal Finance Cockpit — Environment Variables Configuration
# Copy this file to .env.local and fill in the values before starting the application.
# NEVER commit .env or .env.local to version control.

# ── 1. Database (PostgreSQL + Prisma) ──────────────────────────
# Standard PostgreSQL connection URL.
# Example: postgresql://postgres:password@localhost:5432/personal_finance
DATABASE_URL=postgresql://user:password@localhost:5432/personal_finance

# ── 2. Token Security & Encryption ─────────────────────────────
# Master key for authenticated AES-256-GCM encryption of Gmail refresh tokens.
# MUST be exactly 32 bytes (represented as 64 hexadecimal characters).
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── 3. Single-Owner Security Boundary ──────────────────────────
# Passphrase / secret used to sign and verify the owner session cookie (cockpit_owner_session).
# In production, this must be a strong secret string (minimum 32 characters).
# In non-production local development, defaults to 'cockpit-owner-demo-secret-2026'.
OWNER_SECRET_KEY=replace-with-secure-random-owner-secret-key-32chars

# ── 4. Google OAuth 2.0 (Gmail Ingestion) ──────────────────────
# Created in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Scopes required: openid, email, profile, https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── 5. Optional Non-Production Flags ───────────────────────────
# Allow offline demo data fixtures in presentation mode without connecting real Gmail accounts.
ALLOW_DEMO_DATA=false
# Allow mock OAuth flow exclusively for automated test suites.
ALLOW_MOCK_OAUTH=false
